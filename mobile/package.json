{
  "name": "pedalshield-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "node_modules/expo/AppEntry.js",
  "description": "Pedalshield mobile app - React Native + Expo. Verification engine, shielded wallet (Mock + NativeWallet bridge), ride state machine, and screens.",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "node --test src/verification/__tests__/*.test.ts src/wallet/__tests__/*.test.ts src/ride/__tests__/*.test.ts src/prefs/__tests__/*.test.ts src/coop/__tests__/*.test.ts src/map/__tests__/*.test.ts src/lib/__tests__/*.test.ts",
    "test:private": "node --test src/verification-private/__tests__/*.test.ts",
    "test:all": "npm test && npm run test:private",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "expo": "^56.0.12",
    "expo-dev-client": "~56.0.20",
    "expo-file-system": "~56.0.8",
    "expo-haptics": "~56.0.3",
    "expo-keep-awake": "~56.0.3",
    "expo-location": "~56.0.18",
    "expo-sensors": "~56.0.6",
    "expo-speech": "~56.0.3",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.19",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@expo/config-plugins": "^57.0.2",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^20.11.0",
    "@types/react": "~19.2.14",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
