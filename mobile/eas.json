{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.18.0",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "channel": "development-simulator"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "node": "22.18.0",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.pedalshield.app"
      },
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "channel": "production"
    },
    "fogline": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.pedalshield.app",
        "EXPO_PUBLIC_APP": "fogline"
      },
      "channel": "fogline"
    },
    "ghost-commute": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.pedalshield.app",
        "APP_BRAND": "ghost-commute",
        "EXPO_PUBLIC_BRAND": "Ghost Commute"
      },
      "channel": "ghost-commute"
    }
  },
  "submit": {
    "production": {
      "ios": {}
    },
    "fogline": {
      "ios": {}
    },
    "ghost-commute": {
      "ios": {}
    }
  }
}
